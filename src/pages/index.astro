---
import { Image } from 'astro:assets'

import { Quote } from 'astro-pure/advanced'
import { PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import { Button, Card, Icon, Label } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import ProjectCard from '@/components/home/ProjectCard.astro'
import Section from '@/components/home/Section.astro'
import SkillLayout from '@/components/home/SkillLayout.astro'
import WorkExperience from '@/components/home/WorkExperience.astro'
import ContributionGraph from '@/components/home/ContributionGraph.astro'
import avatar from '@/assets/avatar.jpg'
import config from '@/site-config'


const ai = [
  'Python',
  'PyTorch',
  'TensorFlow',
  'Transformer',
  'NLP',
  '模型微调',
  'Embedding',
  
]

const agent = [
  'LangChain/Graph',
  'Spring AI',
  'Multi-Agent Workflow',
  'RAG',
  'NL2SQL',
  'Function Calling',
  'Prompt Engineering',
  'Memory',
  'MCP',
]

const backend = [
  'Java',
  'Spring Boot',
  'Spring Cloud',
  'MyBatis-Plus',
  'Netty',
  'MySQL',
  'Redis',
  'Kafka',
  'Elasticsearch',
]

const devops = [
  'Docker',
  'Kubernetes',
  'Linux',
  'Nginx',
  'Git',
  'CI/CD',
  'Prometheus',
  'Grafana',
]





const MAX_POSTS = 10
const allPosts = await getBlogCollection()
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS)
---

<PageLayout meta={{ title: 'Home' }} highlightColor='#659EB9'>
  <main class='flex w-full flex-col items-center'>
    <section class='animate mb-10 flex flex-col items-center gap-y-7' id='content-header'>
      <Image
        src={avatar}
        alt='profile'
        class='h-28 w-auto rounded-full border p-1'
        loading='eager'
      />

      <div class='flex flex-col items-center gap-y-4'>
        <h1 class='text-3xl font-bold'>{config.author}</h1>
        <div class='flex flex-wrap justify-center gap-x-7 gap-y-3'>
          <Label title='China Wuhan'>
            <Icon name='location' class='size-5' slot='icon' />
          </Label>
          <Label title='GitHub' as='a' href='' target='_blank'>
            <Icon name='github' class='size-5' slot='icon' />
          </Label>
          <Label title='peng@qq.com'>
            <Icon name='email' class='size-5' slot='icon' />
          </Label>
        </div>
      </div>

      
    </section>

    <div id='content' class='animate flex flex-col gap-y-10 w-full max-w-6xl mx-auto'>
      <Section title='关于我'>
        <p class='text-muted-foreground mt-1'>Developer / Novelist / <del>Student </del></p>
        <div class='flex flex-col gap-2 leading-6 text-muted-foreground'>
          <p>Java programmer, passionate about programming, fond of learning new things, enjoys reading, writing, listening to music, and playing games。</p>
          
        </div>
        <!-- <Button title='More about me' class='w-fit self-end' href='/about' style='ahead' /> -->
      </Section>

      <Section title='记录'>
        <ContributionGraph posts={allPosts} />
      </Section>
      {
        allPostsByDate.length > 0 && (
          <Section title='博文'>
            <ul class='flex flex-col gap-y-1.5 sm:gap-y-2'>
              {allPostsByDate.map((p) => (
                <li class='flex flex-col gap-x-2 sm:flex-row'>
                  <PostPreview post={p} />
                </li>
              ))}
            </ul>
            <Button title='More posts' class='w-fit self-end' href='/blog' variant='ahead' />
          </Section>
        )
      }

      <Section title='工作经历'>
        <WorkExperience
          company='某科技有限公司'
          position='高级 Java 开发工程师'
          period='2023.06 - 至今'
          description='负责公司核心业务系统的架构设计与开发，主导微服务架构的落地实施，优化系统性能和稳定性。'
          highlights={['Spring Cloud', '微服务架构', '高并发优化', '团队管理']}
        />
        <WorkExperience
          company='某互联网公司'
          position='Java 开发工程师'
          period='2021.07 - 2023.05'
          description='参与电商平台后端开发，负责订单系统、支付模块的设计与实现，确保系统高可用和数据一致性。'
          highlights={['Spring Boot', 'MySQL', 'Redis', 'RabbitMQ']}
        />
        <WorkExperience
          company='某软件公司'
          position='初级 Java 开发工程师'
          period='2020.03 - 2021.06'
          description='参与企业级管理系统的开发，负责后端接口开发与数据库设计，积累扎实的 Java 基础和项目经验。'
          highlights={['Java Core', 'MyBatis', 'Oracle', 'Linux']}
        />
      </Section>

