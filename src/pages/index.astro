      <Section title='技术栈'>
        <div class='grid grid-cols-1 md:grid-cols-2 gap-6'>
          <SkillLayout title='AI infra' skills={ai} />
          <SkillLayout title='Agent dev' skills={agent} />
          <SkillLayout title='后端' skills={backend} />
          <SkillLayout title='运维' skills={devops} />
        </div>
      </Section>
    </div>
   <Quote class='mt-12' /> 
    <!-- <p class='mt-12'>莫愁前路无知己，天下谁人不识君</p>  -->
  </main>
</PageLayout>
