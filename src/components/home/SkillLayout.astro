---
type Props = {
  title: string
  skills: string[]
}

const { title, skills } = Astro.props
---

<div class='skill-category'>
  <h3 class='mb-3 text-base font-bold text-primary uppercase tracking-wider'>{title}</h3>
  <div class='flex flex-wrap gap-2'>
    {skills.map((skill: string) => (
      <span class='skill-tag inline-flex items-center rounded-full bg-muted px-3 py-1.5 text-sm font-medium text-foreground transition-all hover:bg-primary/10 hover:text-primary hover:scale-105 cursor-default'>
        {skill}
      </span>
    ))}
  </div>
</div>

<style>
  .skill-tag {
    border: 1px solid transparent;
  }
  
  .skill-tag:hover {
    border-color: hsl(var(--primary) / 0.3);
    box-shadow: 0 2px 8px hsl(var(--primary) / 0.1);
  }
</style>
