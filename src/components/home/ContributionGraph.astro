---
interface Props {
  posts: Array<{
    data: {
      publishDate: Date
    }
  }>
}

const { posts } = Astro.props

const currentYear = new Date().getFullYear()
const years = Array.from({ length: 5 }, (_, i) => currentYear - i)

const postCountMap: Record<string, number> = {}
posts.forEach(post => {
  const date = new Date(post.data.publishDate)
  const year = date.getFullYear()
  const month = String(date.getMonth() + 1).padStart(2, '0')
  const day = String(date.getDate()).padStart(2, '0')
  const dateStr = `${year}-${month}-${day}`
  postCountMap[dateStr] = (postCountMap[dateStr] || 0) + 1
})

const monthLabels = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']
const dayLabels = ['', 'Mon', '', 'Wed', '', 'Fri', '']

function generateYearData(year: number) {
  const startDate = new Date(year, 0, 1)
  const endDate = new Date(year, 11, 31)

  const weeks: Array<Array<{ date: string; count: number }>> = []
  let currentWeek: Array<{ date: string; count: number }> = []

  const firstDayOfWeek = startDate.getDay()
  for (let i = 0; i < firstDayOfWeek; i++) {
    currentWeek.push({ date: '', count: -1 })
  }

  const currentDate = new Date(startDate)
  while (currentDate <= endDate) {
    const y = currentDate.getFullYear()
    const m = String(currentDate.getMonth() + 1).padStart(2, '0')
    const d = String(currentDate.getDate()).padStart(2, '0')
    const dateStr = `${y}-${m}-${d}`
    currentWeek.push({ date: dateStr, count: postCountMap[dateStr] || 0 })
    if (currentWeek.length === 7) {
      weeks.push(currentWeek)
      currentWeek = []
    }
    currentDate.setDate(currentDate.getDate() + 1)
  }

  if (currentWeek.length > 0) {
    while (currentWeek.length < 7) {
      currentWeek.push({ date: '', count: -1 })
    }
    weeks.push(currentWeek)
  }

  // 每个月第一列索引
  const monthFirstCol: Record<number, number> = {}
  let lastMonth = -1
  weeks.forEach((week, colIndex) => {
    week.forEach(day => {
      if (day.date) {
        const m = new Date(day.date).getMonth()
        if (m !== lastMonth && monthFirstCol[m] === undefined) {
          monthFirstCol[m] = colIndex
          lastMonth = m
        }
      }
    })
  })

  const yearPosts = posts.filter(p => new Date(p.data.publishDate).getFullYear() === year).length
  const yearActiveDays = Object.keys(postCountMap).filter(d => d.startsWith(year.toString())).length

  return { weeks, monthFirstCol, totalPosts: yearPosts, activeDays: yearActiveDays }
}

const yearData: Record<number, ReturnType<typeof generateYearData>> = {}
years.forEach(year => {
  yearData[year] = generateYearData(year)
})

function getColorClass(count: number): string {
  if (count === -1) return 'bg-transparent'
  if (count === 0) return 'bg-muted'
  if (count === 1) return 'bg-[#aceebb]'
  if (count === 2) return 'bg-emerald-500 dark:bg-emerald-500'
  if (count === 3) return 'bg-emerald-600 dark:bg-emerald-400'
  return 'bg-emerald-700 dark:bg-emerald-300'
}
---

<div class='contribution-graph w-full' id='contribution-graph'>
  {years.map(year => (
    <div
      class={`year-panel ${year === currentYear ? '' : 'hidden'}`}
      data-year={year}
      id={`year-${year}`}
    >
      <div class='mb-3 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3'>
        <div class='flex items-center gap-4 text-sm text-muted-foreground'>
          <span>{yearData[year].totalPosts} posts in {year}</span>
          <span>{yearData[year].activeDays} active days</span>
        </div>
        <div class='flex items-center gap-1 rounded-lg bg-muted p-1 w-fit'>
          {years.map(y => (
            <button
              class={`year-tab px-3 py-1.5 text-sm font-medium rounded-md transition-all ${y === currentYear ? 'bg-background text-foreground shadow-sm' : 'text-muted-foreground hover:text-foreground'}`}
              data-year={y}
            >
              {y}
            </button>
          ))}
        </div>
      </div>

      <div class='overflow-x-auto rounded-lg border border-border/50 bg-background p-4'>
        <div style='display:flex; flex-direction:column; gap:3px; min-width:fit-content'>
          <!-- Row 0: Month labels -->
          <div style='display:flex; gap:3px'>
            <div style='width:28px; flex-shrink:0'></div>
            {yearData[year].weeks.map((_, colIndex) => {
              const monthEntry = Object.entries(yearData[year].monthFirstCol).find(
                ([, c]) => c === colIndex
              )
              return (
                <div style='flex:1; font-size:10px; display:flex; align-items:flex-end; min-width:0'>
                  <span class='text-muted-foreground leading-none'>
                    {monthEntry ? monthLabels[parseInt(monthEntry[0])] : ''}
                  </span>
                </div>
              )
            })}
          </div>

          <!-- Rows 1-7: Day cells with day labels -->
          {[0, 1, 2, 3, 4, 5, 6].map(dayIndex => (
            <div style='display:flex; gap:3px'>
              {/* Day label */}
              <div style='width:28px; flex-shrink:0; font-size:10px; display:flex; align-items:center; justify-content:flex-end'>
                <span class='text-muted-foreground leading-none'>{dayLabels[dayIndex]}</span>
              </div>
              {/* Day cells for each week */}
              {yearData[year].weeks.map(week => {
                const day = week[dayIndex]
                if (day.date) {
                  if (day.count > 0) {
                    return (
                      <a
                        href={`/blog/date/${day.date}`}
                        class={`block rounded-sm ${getColorClass(day.count)} transition-all hover:scale-110 hover:ring-2 hover:ring-primary/50`}
                        style='flex:1; aspect-ratio:1; min-width:0'
                        title={`${day.date}: ${day.count} post${day.count !== 1 ? 's' : ''}`}
                        data-date={day.date}
                        data-count={day.count}
                      ></a>
                    )
                  }
                  return (
                    <div
                      class={`block rounded-sm ${getColorClass(day.count)}`}
                      style='flex:1; aspect-ratio:1; min-width:0'
                      title={`${day.date}: 0 posts`}
                      data-date={day.date}
                      data-count={day.count}
                    ></div>
                  )
                }
                return <div style='flex:1; aspect-ratio:1; min-width:0'></div>
              })}
            </div>
          ))}
        </div>

        <div class='mt-3 flex items-center justify-end gap-1.5'>
          <span class='text-xs text-muted-foreground'>Less</span>
          <div class='h-3 w-3 rounded-sm bg-muted'></div>
          <div class='h-3 w-3 rounded-sm bg-[#aceebb]'></div>
          <div class='h-3 w-3 rounded-sm bg-emerald-500 dark:bg-emerald-500'></div>
          <div class='h-3 w-3 rounded-sm bg-emerald-600 dark:bg-emerald-400'></div>
          <div class='h-3 w-3 rounded-sm bg-emerald-700 dark:bg-emerald-300'></div>
          <span class='text-xs text-muted-foreground'>More</span>
        </div>
      </div>
    </div>
  ))}

  <div id='contribution-tooltip' class='fixed z-50 rounded-md bg-foreground px-3 py-1.5 text-xs text-background shadow-lg opacity-0 pointer-events-none transition-opacity duration-200'></div>
</div>

<script>
  const yearTabs = document.querySelectorAll('.year-tab');
  const yearPanels = document.querySelectorAll('.year-panel');

  yearTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const year = (tab as HTMLElement).dataset.year;
      yearTabs.forEach(t => {
        t.classList.remove('bg-background', 'text-foreground', 'shadow-sm');
        t.classList.add('text-muted-foreground');
      });
      tab.classList.add('bg-background', 'text-foreground', 'shadow-sm');
      tab.classList.remove('text-muted-foreground');
      yearPanels.forEach(panel => {
        if ((panel as HTMLElement).dataset.year === year) {
          panel.classList.remove('hidden');
        } else {
          panel.classList.add('hidden');
        }
      });
    });
  });

  const tooltip = document.getElementById('contribution-tooltip');
  document.addEventListener('mouseenter', (e) => {
    const target = e.target as HTMLElement;
    if (target.dataset.date && target.dataset.count !== undefined) {
      const { date, count } = target.dataset;
      if (tooltip && date && count) {
        tooltip.textContent = `${count} post${count !== '1' ? 's' : ''} on ${new Date(date).toLocaleDateString('en-US', { weekday:'long', year:'numeric', month:'long', day:'numeric' })}`;
        tooltip.style.opacity = '1';
      }
    }
  }, true);
  document.addEventListener('mousemove', (e) => {
    if (tooltip && tooltip.style.opacity === '1') {
      tooltip.style.left = `${e.clientX + 12}px`;
      tooltip.style.top = `${e.clientY - 28}px`;
    }
  }, true);
  document.addEventListener('mouseleave', (e) => {
    const target = e.target as HTMLElement;
    if (target.dataset.date && tooltip) tooltip.style.opacity = '0';
  }, true);
</script>

<style>
  .contribution-graph { max-width: 100%; }
  .year-tab { cursor: pointer; min-width: 56px; text-align: center; }
  @media (max-width: 640px) {
    .year-tab { padding: 0.25rem 0.5rem; font-size: 0.75rem; min-width: 48px; }
  }
</style>
