---
interface Props {
  company: string
  position: string
  period: string
  description: string
  highlights?: string[]
}

const { company, position, period, description, highlights } = Astro.props
---

<div class='group relative overflow-hidden rounded-lg border border-border/50 bg-background p-5 transition-all hover:border-primary/30 hover:shadow-sm'>
  <div class='flex flex-col gap-y-3'>
    <div class='flex flex-col gap-y-1 sm:flex-row sm:items-center sm:justify-between'>
      <div>
        <h3 class='text-lg font-semibold text-foreground'>{company}</h3>
        <p class='text-sm font-medium text-primary'>{position}</p>
      </div>
      <span class='mt-1 inline-flex items-center rounded-full bg-muted px-3 py-1 text-xs font-medium text-muted-foreground sm:mt-0'>
        {period}
      </span>
    </div>
    <p class='text-sm leading-relaxed text-muted-foreground'>{description}</p>
    {highlights && highlights.length > 0 && (
      <ul class='mt-1 flex flex-wrap gap-2'>
        {highlights.map((item) => (
          <li class='inline-flex items-center rounded-md bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary'>
            {item}
          </li>
        ))}
      </ul>
    )}
  </div>
</div>
